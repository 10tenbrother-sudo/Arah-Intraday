# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_SECRET: Signs the session JWTs issued by /api/auth/login.
# REQUIRED in production: the server refuses to boot without it, and a token
# signed with the development fallback is not recognised across restarts.
# Generate one with:  openssl rand -hex 32
APP_SECRET="CHANGE_ME_openssl_rand_hex_32"

# NODE_ENV: Set to "production" on any deployed instance. This also disables
# echoing verification/reset links back in API responses.
NODE_ENV="development"

# AUTH_DEV_LINK_ECHO: Local-development convenience only. When "true" (and
# NODE_ENV is not production) the API returns verification/reset/magic links in
# its JSON response so the flows can be tested without an SMTP server. Leave
# unset on any shared or deployed instance — it hands tokens to the caller.
AUTH_DEV_LINK_ECHO=""

# DATABASE_URL: SQLite file used by Prisma for the primary data store.
DATABASE_URL="file:./data/market_intelligence.sqlite"

# ---------------------------------------------------------------------------
# Optional integrations. Each feature degrades gracefully when left unset.
# ---------------------------------------------------------------------------

# SMTP delivery for verification, reset and magic-link emails. Without these the
# links are only logged to the server console (development behaviour).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Cloud SQL / PostgreSQL mirror. Unset means the mirror is skipped.
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Set to "query" to log every Prisma query.
PRISMA_LOG=""

# ADMIN_EMAILS: Comma-separated addresses promoted to ADMIN on startup. Only
# existing accounts are promoted — the account must be registered first.
ADMIN_EMAILS=""

# ADMIN_EMAIL: Address for the bootstrap admin created only on an empty database.
ADMIN_EMAIL="admin@marketintel.pro"

# ADMIN_INITIAL_PASSWORD: Password for that bootstrap admin. If unset, a random
# password is generated and printed once in the startup log.
ADMIN_INITIAL_PASSWORD=""

# DEMO_USER_PASSWORD: Password for the seeded demo account. If unset, a random
# password is generated — the old hardcoded value is in the public git history.
DEMO_USER_PASSWORD=""

